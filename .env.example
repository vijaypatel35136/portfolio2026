# Server Configuration
PORT=3001
NODE_ENV=development

# JWT Secret (change this in production!)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Supabase Client Configuration (Frontend)
VITE_SUPABASE_URL=your-supabase-project-url
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Supabase Service Role Key (Backend ONLY - for bypassing RLS)
# Get this from: Supabase Dashboard → Project Settings → API → service_role key
# IMPORTANT: Keep this secret! Never expose in frontend code
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# PostgreSQL Database Configuration (Server-Side ONLY)
# Supabase Connection Pooler
DB_HOST=your-supabase-pooler-host
DB_PORT=5432
DB_NAME=postgres
DB_USER=your-supabase-db-user
DB_PASSWORD=your-supabase-db-password

# Admin Credentials (seeded on first run)
ADMIN_EMAIL=admin@vijay.dev
ADMIN_PASSWORD=admin123

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./server/uploads
